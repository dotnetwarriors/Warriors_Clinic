@{
    ViewData["Title"] = "About Clinic";
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">About Warriors Clinic</h1>
        <p class="text-muted mx-auto" style="max-width: 700px;">
            Warriors Clinic is dedicated to providing high-quality healthcare services with compassion and care.
            We use modern technology and experienced professionals to ensure the best treatment for our patients.
            Our focus is on patient satisfaction, quick recovery, and personalized medical solutions.
        </p>
    </div>

    <!-- CARDS -->
    <div class="row g-4 justify-content-center">

        <!-- SERVICES -->
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 text-center p-4">
                <div class="text-primary mb-3">
                    <i class="bi bi-heart-pulse display-4"></i>
                </div>
                <h5 class="fw-bold">Services</h5>
                <ul class="list-unstyled mt-3 text-muted">
                    <li>✔ General Consultation</li>
                    <li>✔ Diagnostics & Lab Tests</li>
                    <li>✔ Emergency Care</li>
                    <li>✔ Pharmacy</li>
                </ul>
            </div>
        </div>

        <!-- ADDRESS -->
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 text-center p-4">
                <div class="text-primary mb-3">
                    <i class="bi bi-geo-alt display-4"></i>
                </div>
                <h5 class="fw-bold">Address</h5>
                <p class="text-muted mt-3">
                    123 Health Street<br>
                    Your City, India<br>
                    PIN: 560001
                </p>
            </div>
        </div>

        <!-- CONTACT -->
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 text-center p-4">
                <div class="text-primary mb-3">
                    <i class="bi bi-telephone display-4"></i>
                </div>
                <h5 class="fw-bold">Contact</h5>
                <p class="text-muted mt-3">
                    📞 +91 98765 43210<br>
                    📧 info@warriorsclinic.com
                </p>
            </div>
        </div>

    </div>

</div>