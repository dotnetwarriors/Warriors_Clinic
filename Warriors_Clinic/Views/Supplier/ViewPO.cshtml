@model List<Warriors_Clinic.Models.PurchaseOrderHeader>
 
@{
    ViewData["Title"] = "Purchase Orders";
}
 
<div class="container mt-4">
    <h2 class="fw-bold mb-4">Pending Purchase Orders</h2>
 
    @foreach (var order in Model)
    {
        <div class="card shadow-sm mb-4 p-3">
 
            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">Order ID: @order.Poid</h5>
                    <small class="text-muted">Date: @order.Podate</small>
                </div>
 
                <div>
                    <a asp-action="ApprovePO" asp-route-id="@order.Poid"
                       class="btn btn-success btn-sm">✔ Accept</a>
 
                    <a asp-action="RejectPO" asp-route-id="@order.Poid"
                       class="btn btn-danger btn-sm">✖ Reject</a>
                </div>
            </div>
 
            <hr />
 
            <!-- ORDER DETAILS -->
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Drug</th>
                        <th>Quantity</th>
                        <th>Note</th>
                    </tr>
                </thead>
 
                <tbody>
                    @foreach (var line in order.PurchaseOrderLines)
                    {
                        <tr>
                            <td>@line.Drug?.Tittle</td>
                            <td>@line.Quantity</td>
                            <td>@line.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
 
        </div>
    }
</div>
 