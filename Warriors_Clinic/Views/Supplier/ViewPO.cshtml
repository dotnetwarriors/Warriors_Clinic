@model List<Warriors_Clinic.Models.PurchaseOrderHeader>

@{
    ViewData["Title"] = "Purchase Orders";
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
}

<div class="container-fluid">

    <h2 class="fw-bold mb-4">Purchase Orders</h2>

    @foreach (var order in Model)
    {
        <div class="card shadow-sm mb-3">

            <!-- 🔷 HEADER (CLICKABLE) -->
            <div class="p-3 d-flex justify-content-between align-items-center"
                 style="cursor:pointer;"
                 onclick="toggleDetails(@order.Poid)">

                <div>
                    <strong>Order ID:</strong> @order.Poid |
                    <strong>Supplier:</strong> @order.Supplier?.Name |
                    <strong>Date:</strong> @order.Podate
                </div>

                <div>
                    <span id="icon_@order.Poid">▼</span>
                </div>
            </div>

            <!-- 🔽 DETAILS (HIDDEN BY DEFAULT) -->
            <div id="details_@order.Poid" style="display:none;" class="p-3">

                <!-- 🔷 NOTE FORM -->
                <form asp-action="AddNote" method="post"
                      class="mb-3 d-flex gap-2 align-items-center">

                    <input type="hidden" name="poId" value="@order.Poid" />

                    <select name="note" class="form-select form-select-sm w-auto" required>
                        <option value="">-- Select Response --</option>
                        <option>Noted</option>
                        <option>Out of stock</option>
                        <option>Will deliver tomorrow</option>
                    </select>

                    <button type="submit" class="btn btn-primary btn-sm">
                        Send
                    </button>
                </form>

                <!-- 🔷 SUPPLIER RESPONSE -->
                @if (!string.IsNullOrEmpty(order.SupplierNote))
                {
                    <div class="alert alert-info py-2">
                        <strong>Supplier Response:</strong> @order.SupplierNote
                    </div>
                }

                <!-- 🔷 TABLE -->
                <table class="table table-bordered mt-3">
                    <thead class="table-light">
                        <tr>
                            <th>Drug</th>
                            <th>Quantity</th>
                            <th>Note</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in order.PurchaseOrderLines)
                        {
                            <tr>
                                <td>@line.Drug?.Tittle</td>
                                <td>@line.Quantity</td>
                                <td>@line.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </div>
    }

</div>

<!-- 🔥 TOGGLE SCRIPT -->
<script>
    function toggleDetails(id) {
        var section = document.getElementById("details_" + id);
        var icon = document.getElementById("icon_" + id);

        if (section.style.display === "none") {
            section.style.display = "block";
            icon.innerHTML = "▲";
        } else {
            section.style.display = "none";
            icon.innerHTML = "▼";
        }
    }
</script>