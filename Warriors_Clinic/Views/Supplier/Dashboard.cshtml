@{
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";

    var email = Context.Session.GetString("UserEmail");
    var displayName = string.IsNullOrEmpty(email) ? "User" : email.Split('@')[0];
}

<div class="container-fluid">

    <!-- 🔥 HEADER -->
    <h2 class="mb-4 fw-bold">
        Welcome, @displayName 👋
    </h2>

    <!-- 🔷 STATS CARDS -->
    <div class="row g-4 text-center">

        <!-- TOTAL -->
        <div class="col-md-3">
            <div class="card shadow border-0 bg-primary text-white dashboard-card">
                <div class="card-body">
                    <h6>Total Orders</h6>
                    <h2>@ViewBag.TotalPO</h2>
                </div>
            </div>
        </div>

        <!-- PENDING (NO LINK) -->
        <div class="col-md-3">
            <div class="card shadow border-0 bg-warning text-dark dashboard-card">
                <div class="card-body">
                    <h6>Pending</h6>
                    <h2>@ViewBag.Pending</h2>
                </div>
            </div>
        </div>

        <!-- APPROVED (NO LINK) -->
        <div class="col-md-3">
            <div class="card shadow border-0 bg-success text-white dashboard-card">
                <div class="card-body">
                    <h6>Approved</h6>
                    <h2>@ViewBag.Approved</h2>
                </div>
            </div>
        </div>

        <!-- REJECTED (NO LINK) -->
        <div class="col-md-3">
            <div class="card shadow border-0 bg-danger text-white dashboard-card">
                <div class="card-body">
                    <h6>Rejected</h6>
                    <h2>@ViewBag.Rejected</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- 🔥 ACTION CARDS -->
    <!-- 🔥 ACTION CARDS -->
    <div class="row g-4 mt-4 justify-content-center">

        <!-- PURCHASE ORDERS -->
        <div class="col-md-4">
            <a asp-action="ViewPO"
                   class="btn btn-light w-100 shadow-sm text-center p-4 h-100 border action-card">

                <i class="bi bi-receipt display-5 text-warning mb-3"></i>
                <h5 class="fw-semibold">Purchase Orders</h5>
                <p class="text-muted small mb-0">
                    View all supplier orders
                </p>

            </a>
        </div>

        <!-- ACCEPTED ORDERS -->
        <div class="col-md-4">
            <a asp-action="AcceptedOrders"
                   class="btn btn-light w-100 shadow-sm text-center p-4 h-100 border action-card">

                <i class="bi bi-check-circle display-5 text-success mb-3"></i>
                <h5 class="fw-semibold">Accepted Orders</h5>
                <p class="text-muted small mb-0">
                    View approved orders
                </p>

            </a>
        </div>

        <!-- REJECTED ORDERS -->
        <div class="col-md-4">
            <a asp-action="RejectedOrders"
                   class="btn btn-light w-100 shadow-sm text-center p-4 h-100 border action-card">

                <i class="bi bi-x-circle display-5 text-danger mb-3"></i>
                <h5 class="fw-semibold">Rejected Orders</h5>
                <p class="text-muted small mb-0">
                    View rejected orders
                </p>

            </a>
        </div>

    </div>

</div>

<!-- 🔥 STYLES -->
<style>
    .dashboard-card {
        border-radius: 12px;
        transition: 0.3s;
        cursor: default; /* ❗ No click cursor */
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

    .action-card {
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .action-card:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }
</style>