@{
    Layout = "~/Views/Shared/_ChemistLayout.cshtml";
}
@{
    var email = Context.Session.GetString("UserEmail");
    var displayName = string.IsNullOrEmpty(email) ? "User" : email.Split('@')[0];
}

<style>
    .hover-card {
        transition: all 0.3s ease;
    }

        .hover-card:hover {
            transform: scale(1.07);
            box-shadow: 0 12px 25px rgba(0,0,0,0.2);
        }
</style>

<div class="container-fluid">

    <h2 class="mb-4 fw-bold">
        Welcome, @displayName 👋
    </h2>

    <div class="row g-4">

        <!-- DRUG REQUESTS -->
        <div class="col-md-4">
            <a asp-action="DrugRequests" class="text-decoration-none">
                <div class="card shadow-sm text-center p-4 border-0 h-100 hover-card">
                    <i class="bi bi-capsule display-5 text-primary mb-3"></i>
                    <h5 class="fw-semibold">Drug Requests</h5>
                    <p class="text-muted small">View physician requests</p>
                </div>
            </a>
        </div>

        <!-- MANAGE DRUGS -->
        <div class="col-md-4">
            <a asp-controller="Drug" asp-action="Index" class="text-decoration-none">
                <div class="card shadow-sm text-center p-4 border-0 h-100 hover-card">
                    <i class="bi bi-box display-5 text-success mb-3"></i>
                    <h5 class="fw-semibold">Manage Drugs</h5>
                    <p class="text-muted small">Add / Edit medicines</p>
                </div>
            </a>
        </div>

        <!-- PURCHASE ORDER -->
        <div class="col-md-4">
            <a asp-action="POList" class="text-decoration-none">
                <div class="card shadow-sm text-center p-4 border-0 h-100 hover-card">
                    <i class="bi bi-receipt display-5 text-warning mb-3"></i>
                    <h5 class="fw-semibold">Purchase Orders</h5>
                    <p class="text-muted small">Manage supplier orders</p>
                </div>
            </a>
        </div>

    </div>

</div>