@model List<Warriors_Clinic.Models.PurchaseOrderHeader>

@{
    ViewData["Title"] = "Purchase Orders";
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
}

<div class="container-fluid">

    <h2 class="fw-bold mb-4">Purchase Orders</h2>

    @foreach (var order in Model)
    {
        <div class="card shadow-sm mb-4 p-3">

            <!-- 🔷 HEADER -->
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5>Order ID: @order.Poid</h5>
                    <small class="text-muted">Date: @order.Podate</small>
                </div>

            </div>

            <!-- 🔷 NOTE FORM -->
            <form asp-action="AddNote" method="post" class="mt-3 d-flex gap-2 align-items-center">

                <input type="hidden" name="poId" value="@order.Poid" />

                <select name="note" class="form-select form-select-sm w-auto" required>
                    <option value="">-- Select Response --</option>
                    <option>Noted</option>
                    <option>Out of stock</option>
                    <option>Will deliver tomorrow</option>
                </select>

                <button type="submit" class="btn btn-primary btn-sm">
                    Send
                </button>

            </form>

            <hr />

            <!-- 🔷 SHOW NOTE -->
            @if (!string.IsNullOrEmpty(order.SupplierNote))
            {
                <p class="mt-2 text-primary">
                    <strong>Supplier Response:</strong> @order.SupplierNote
                </p>
            }

            <!-- 🔷 TABLE -->
            <table class="table table-bordered mt-3">
                <thead class="table-light">
                    <tr>
                        <th>Drug</th>
                        <th>Quantity</th>
                        <th>Note</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var line in order.PurchaseOrderLines)
                    {
                        <tr>
                            <td>@line.Drug?.Tittle</td>
                            <td>@line.Quantity</td>
                            <td>@line.Note</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }

</div>