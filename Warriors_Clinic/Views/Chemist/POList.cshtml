@{
    Layout = "~/Views/Shared/_ChemistLayout.cshtml";
}
@model List<Warriors_Clinic.Models.PurchaseOrderHeader>

<style>
    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 14px;
        border-radius: 8px;
    }
</style>

<h2 class="fw-bold mb-3">PO List</h2>

<a href="/Chemist/CreatePO" class="btn btn-success mb-3">
    + New PO
</a>

<table class="table table-bordered table-hover shadow-sm">

    <thead class="table-dark">
        <tr>
            <th>PO ID</th>
            <th>Supplier</th>
            <th>Drugs</th>
            <th>Supplier Response</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var po in Model)
        {
            <tr>
                <td>@po.Poid</td>

                <td>@po.Supplier?.Name</td>

                <td>
                    @foreach (var line in po.PurchaseOrderLines)
                    {
                        <div>
                            @line.Drug?.Tittle (@line.Quantity)
                        </div>
                    }
                </td>

                <!-- 🔥 COLOR BASED RESPONSE -->
                <td>
                    @{
                        var note = po.SupplierNote ?? "";
                        string badgeClass = "bg-secondary";

                        if (note == "Noted")
                        {
                            badgeClass = "bg-primary";
                        }
                        else if (note == "Out of stock")
                        {
                            badgeClass = "bg-danger";
                        }
                        else if (note == "Will deliver tomorrow")
                        {
                            badgeClass = "bg-success";
                        }
                    }

                    @if (!string.IsNullOrEmpty(note))
                    {
                        <span class="badge @badgeClass px-3 py-2">
                            @note
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">No response</span>
                    }
                </td>

            </tr>
        }
    </tbody>

</table>