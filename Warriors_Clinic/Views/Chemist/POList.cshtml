@{
    Layout = "~/Views/Shared/_ChemistLayout.cshtml";
}
@model List<Warriors_Clinic.Models.PurchaseOrderHeader>
 
<h2>PO List</h2>
 
<a href="/Chemist/CreatePO" class="btn btn-success mb-3">
    + New PO
</a>
 
<table class="table table-bordered">
 
    <thead class="table-dark">
        <tr>
            <th>PO ID</th>
            <th>Supplier</th>
            <th>Drugs</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
 
    <tbody>
        @foreach (var po in Model)
        {
            <tr>
                <td>@po.Poid</td>
                <td>@po.Supplier?.Name</td>
 
                <td>
                    @foreach (var line in po.PurchaseOrderLines)
                    {
                        <div>
                            @line.Drug?.Tittle (@line.Quantity)
                        </div>
                    }
                </td>
 
                <td>
                    @if (po.Status == "Approved")
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else if (po.Status == "Rejected")
                    {
                        <span class="badge bg-danger">Rejected</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </td>
 
                <td>
                    @if (po.Status == "Approved")
                    {
                        <a asp-action="DeletePO"
                               asp-route-id="@po.Poid"
                               class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
 
</table>
 