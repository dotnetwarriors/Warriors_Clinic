@{
    Layout = "~/Views/Shared/_ChemistLayout.cshtml";
}
 
<h2>Create Purchase Order</h2>
 
<form asp-action="CreatePO" method="post">
 
    <!-- Supplier -->
    <div class="mb-3">
        <label>Select Supplier</label>
        <select name="SupplierId" class="form-control" required>
            <option value="">-- Select Supplier --</option>
            @foreach (var s in ViewBag.Suppliers)
            {
                <option value="@s.SupplierId">@s.Name</option>
            }
        </select>
    </div>
 
    <!-- TABLE -->
    <table class="table" id="poTable">
        <thead>
            <tr>
                <th>Drug</th>
                <th>Quantity</th>
                <th>Note</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <select name="Lines[0].DrugId" class="form-control">
                        @foreach (var d in ViewBag.Drugs)
                        {
                            <option value="@d.DrugId">@d.Tittle</option>
                        }
                    </select>
                </td>
                <td>
                    <input type="number" name="Lines[0].Quantity" class="form-control" />
                </td>
                <td>
                    <input type="text" name="Lines[0].Note" class="form-control" />
                </td>
                <td>
                    <button type="button" class="btn btn-danger" onclick="removeRow(this)">X</button>
                </td>
            </tr>
        </tbody>
    </table>
 
    <button type="button" class="btn btn-primary" onclick="addRow()">+ Add Drug</button>
 
    <br /><br />
 
    <button type="submit" class="btn btn-success">Save PO</button>
</form>
 
<script>
    let index = 1;
 
    function addRow() {
        let table = document.getElementById("poTable").getElementsByTagName('tbody')[0];
 
        let row = table.insertRow();
 
        row.innerHTML = `
            <td>
                <select name="Lines[${index}].DrugId" class="form-control">
                    @foreach (var d in ViewBag.Drugs)
                    {
                            <option value="@d.DrugId">@d.Tittle</option>
                    }
                </select>
            </td>
            <td>
                <input type="number" name="Lines[${index}].Quantity" class="form-control" />
            </td>
            <td>
                <input type="text" name="Lines[${index}].Note" class="form-control" />
            </td>
            <td>
                <button type="button" class="btn btn-danger" onclick="removeRow(this)">X</button>
            </td>
        `;
 
        index++;
    }
 
    function removeRow(btn) {
        let row = btn.parentNode.parentNode;
        row.parentNode.removeChild(row);
    }
</script>