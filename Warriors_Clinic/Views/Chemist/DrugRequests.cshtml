@model List<Warriors_Clinic.Models.DrugRequest>

@{
    Layout = "~/Views/Shared/_ChemistLayout.cshtml";
}

<div class="card shadow">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">Drug Requests</h4>
    </div>

    <div class="card-body">

        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Physician</th>
                    <th>Request</th>
                    <th>Date</th>
                    <th>Response</th> <!-- ✅ ONLY ONE COLUMN -->
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <!-- Physician -->
                            <td>
                                @(item.Physician != null ? item.Physician.Name : "N/A")
                            </td>

                            <!-- Request -->
                            <td>
                                @(string.IsNullOrEmpty(item.DrugInfoText) ? "No Drug Info" : item.DrugInfoText)
                            </td>

                            <!-- Date -->
                            <td>
                                @item.RequestDate?.ToString("dd MMM yyyy")
                            </td>

                            <!-- 🔥 COMBINED RESPONSE COLUMN -->
                            <td>
                                @if (string.IsNullOrEmpty(item.ChemistNote))
                                {
                                    <form asp-action="AddChemistNote" method="post" class="d-flex gap-2">

                                        <input type="hidden" name="id" value="@item.DrugRequestId" />

                                        <select name="note" class="form-select form-select-sm w-auto" required>
                                            <option value="">-- Select --</option>
                                            <option>Noted</option>
                                        </select>

                                        <button class="btn btn-primary btn-sm">
                                            Send
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        ✔ @item.ChemistNote
                                    </span>
                                }
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-danger fw-bold">
                            No drug requests available
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>