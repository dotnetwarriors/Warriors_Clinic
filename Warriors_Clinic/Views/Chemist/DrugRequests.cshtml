@model List<Warriors_Clinic.Models.DrugRequest>

@{
    Layout = "~/Views/Shared/_ChemistLayout.cshtml";
}

<div class="card shadow">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">Drug Requests</h4>
    </div>

    <div class="card-body">

        <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Physician</th>
                    <th>Request</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Physician?.Name</strong></td>
                            <td>@item.DrugInfoText</td>
                            <td>@item.RequestDate?.ToString("dd MMM yyyy")</td>
                            <td>@item.RequestStatus</td>
                            <td>
                                @if (item.RequestStatus == "Pending")
                                {
                                    <a asp-action="ApproveRequest" asp-route-id="@item.DrugRequestId" class="btn btn-success btn-sm">Accept</a>
                                    <a asp-action="RejectRequest" asp-route-id="@item.DrugRequestId" class="btn btn-danger btn-sm">Reject</a>
                                }
                                else
                                {
                                    <span class="badge bg-success">@item.RequestStatus</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-danger fw-bold">
                            No drug requests available
                        </td>
                    </tr>
                }
 
            </tbody>
        </table>

    </div>
</div>