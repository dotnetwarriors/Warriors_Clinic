@model Warriors_Clinic.Models.Appointment
 
@{
    ViewData["Title"] = "Book Appointment";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}
 
<h2 class="text-center mt-4">Book Appointment</h2>
 
<div class="container mt-4">
    <form asp-action="Create" method="post">
 
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

 
        <div class="mb-3">
            <label class="form-label">Appointment Date & Time</label>
            <input asp-for="AppointmentDateTime"
                   type="datetime-local"
                   class="form-control"
                   id="appointmentDate" />
         </div>
 
        <div class="mb-3">
            <label class="form-label">Reason</label>
            <input asp-for="Reason" class="form-control" placeholder="Describe your issue" />
        </div>
 
        <div class="mb-3">
            <label class="form-label">Criticality</label>
            <label class="form-label">Priority</label>
            <select asp-for="Criticality" class="form-control">
                <option value="Routine">Routine</option>
                <option value="Urgent">Urgent</option>
                <option value="Emergency">Emergency</option>
            </select>
        </div>
 
        <div class="mb-3">
            <label class="form-label">Note (Optional)</label>
            <input asp-for="Note" class="form-control" />
        </div>
 
        <button type="submit" class="btn btn-primary w-100">Book Appointment</button>
 
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
 
        let input = document.getElementById("appointmentDate");
 
        let now = new Date();
 
        // Format: yyyy-MM-ddTHH:mm
        let formatted = now.toISOString().slice(0,16);
 
        // ✅ Disable past date & time
        input.min = formatted;
 
        // ❌ Block typing
        input.addEventListener("keydown", function (e) {
            e.preventDefault();
        });
 
        // ❌ Block paste
        input.addEventListener("paste", function (e) {
            e.preventDefault();
        });
 
    });
</script>
 