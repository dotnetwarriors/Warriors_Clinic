@model List<Warriors_Clinic.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<h2 class="text-center mt-4">My Appointments</h2>

<table class="table table-bordered mt-4">
    <thead class="table-dark">
        <tr>
            <th>Doctor</th>
            <th>Date & Time</th>
            <th>Reason</th>
            <th>Status</th>

        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Physician?.Name</td>
                <td>@item.AppointmentDateTime</td>
                <td>@item.Reason</td>
                <td>@item.ScheduleStatus</td>


            </tr>
        }
    </tbody>
</table>