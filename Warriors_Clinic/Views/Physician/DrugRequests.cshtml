@model List<Warriors_Clinic.Models.DrugRequest>

@{
    Layout = "~/Views/Shared/_PhysicianLayout.cshtml";
}

<h2 class="mb-3 fw-bold">Drug Requests</h2>

<!-- ✅ BUTTON -->
<button class="btn btn-primary mb-3" onclick="toggleForm()">
    + New Request
</button>

<!-- ✅ TABLE -->
<table class="table table-bordered table-hover shadow-sm align-middle">

    <thead class="table-dark">
        <tr>
            <th>Drug</th>
            <th>Chemist</th>
            <th>Date</th>
            <th>Response</th> <!-- 🔥 RENAMED -->
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>

                    <!-- Drug -->
                    <td>
                        @(string.IsNullOrEmpty(item.DrugInfoText) ? "No Drug Info" : item.DrugInfoText)
                    </td>

                    <!-- Chemist -->
                    <td>@item.Chemist?.Name</td>

                    <!-- Date -->
                    <td>
                        @item.RequestDate?.ToString("dd MMM yyyy, hh:mm tt")
                    </td>

                    <!-- 🔷 RESPONSE -->
                    <td>
                        @if (!string.IsNullOrEmpty(item.ChemistNote))
                        {
                            <span class="badge bg-success px-3 py-2">
                                ✔ @item.ChemistNote
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Waiting for response...</span>
                        }
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-danger fw-bold">
                    No drug requests available
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ✅ FORM -->
<div id="requestForm" style="display:none; margin-top:20px;">
    <div class="card p-3 shadow-sm">
        <h5>New Drug Request</h5>

        <form asp-action="CreateDrugRequest" method="post">

            <!-- Chemist -->
            <div class="mb-3">
                <label>Select Chemist</label>
                <select name="ChemistId" class="form-control" required>
                    <option value="">-- Select Chemist --</option>
                    @foreach (var chemist in ViewBag.Chemists)
                    {
                        <option value="@chemist.ChemistId">
                            @chemist.Name
                        </option>
                    }
                </select>
            </div>

            <!-- Drug -->
            <div class="mb-3">
                <label>Drug Name</label>
                <input type="text" name="DrugInfoText" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-success">Submit</button>
        </form>
    </div>
</div>

<!-- ✅ SCRIPT -->
<script>
    function toggleForm() {
        var form = document.getElementById("requestForm");
        form.style.display = (form.style.display === "none") ? "block" : "none";
    }
</script>

<!-- 🔥 OPTIONAL UI POLISH -->
<style>
    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 14px;
        border-radius: 10px;
    }
</style>