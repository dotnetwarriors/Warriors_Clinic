@model IEnumerable<Warriors_Clinic.Models.Schedule>
 
@{
    ViewData["Title"] = "Prescriptions";
    Layout = "~/Views/Shared/_PhysicianLayout.cshtml";
}
 
<h2 class="mb-4">💊 Prescriptions</h2>

<table class="table table-bordered table-hover shadow-sm align-middle">

    <thead class="table-dark text-center">
        <tr>
            <th>Patient</th>
            <th>Appointment</th>
            <th>Contact</th>
            <th>Date</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <!-- 👤 PATIENT -->
                <td>
                    <strong>@item.Appointment.Patient.Name</strong><br />
                    <small class="text-muted">ID: @item.Appointment.Patient.PatientId</small>
                </td>

                <!-- 📅 APPOINTMENT -->
                <td class="text-center">
                    #@item.Appointment.AppointmentId
                </td>

                <!-- 📞 CONTACT -->
                <td>
                    <small>📞 @item.Appointment.Patient.Phone</small><br />
                    <small class="text-muted">@item.Appointment.Patient.Address</small>
                </td>

                <!-- 🕒 DATE -->
                <td>
                    @(item.Appointment.AppointmentDateTime?.ToString("dd MMM yyyy"))<br />
                    <small class="text-muted">
                        @(item.Appointment.AppointmentDateTime?.ToString("hh:mm tt"))
                    </small>
                </td>

                <!-- 🧾 REASON -->
                <td>
                    @item.Appointment.Reason
                </td>

                <!-- 📌 STATUS -->
                <td class="text-center">
                    @if (item.ScheduleStatus == ScheduleStatusEnum.Consulted)
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">Pending</span>
                    }
                    else if (item.ScheduleStatus.ToString() == "Added")
                    {
                        <span class="badge bg-success px-3 py-2">Prescribed</span>
                    }
                </td>

                <!-- ⚙️ ACTION -->
                <td class="text-center">

                    @if (item.ScheduleStatus == ScheduleStatusEnum.Consulted)
                    {
                        <a asp-action="AddPrescription"
                               asp-controller="Physician"
                               asp-route-id="@item.ScheduleId"
                               class="btn btn-primary btn-sm">
                            Add
                        </a>
                    }
                    else
                    {
                        <a asp-action="AddPrescription"
                               asp-controller="Physician"
                               asp-route-id="@item.ScheduleId"
                               class="btn btn-warning btn-sm">
                            Edit
                        </a>
                    }

                </td>

            </tr>
        }
    </tbody>
</table>