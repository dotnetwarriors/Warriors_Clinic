@model IEnumerable<Warriors_Clinic.Models.Schedule>
 
@{
    ViewData["Title"] = "Prescriptions";
    Layout = "~/Views/Shared/_PhysicianLayout.cshtml";
}
 
<h2 class="mb-4">💊 Prescriptions</h2>
 
<table class="table table-bordered table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>PatientId</th>
            <th>Patient Name</th>
            <th>AppointmentId</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Date & Time</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
 
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Appointment.Patient.PatientId</td>
                <td>@item.Appointment.Patient.Name</td>
                <td>@item.Appointment.AppointmentId</td>
                <td>@item.Appointment.Patient.Phone</td>
                <td>@item.Appointment.Patient.Address</td>
 
                <td>@item.Appointment.AppointmentDateTime</td>
                <td>@item.Appointment.Reason</td>
                <td>
                    @if (item.ScheduleStatus == ScheduleStatusEnum.Consulted)
                    {
                        <span class="badge bg-success">Consulted</span>
                    }
                    else if (item.ScheduleStatus.ToString() == "Added")
                    {
                        <span class="badge bg-primary">Prescription Added</span>
                    }
                </td>
 
                <td>
                    @if (item.ScheduleStatus == ScheduleStatusEnum.Consulted)
                    {
                        <a asp-action="AddPrescription"
                               asp-controller="Physician"
                               asp-route-id="@item.ScheduleId"
                               class="btn btn-primary btn-sm">
                            Add Prescription
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" disabled>
                            Prescription Added
                        </button>
 
                        <a asp-action="DeleteFromPrescription"
                               asp-controller="Physician"
                               asp-route-id="@item.ScheduleId"
                               class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    }
                </td>
 
            </tr>
        }
    </tbody>
</table>