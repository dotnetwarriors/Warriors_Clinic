@model IEnumerable<Warriors_Clinic.Models.Appointment>
 
@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Shared/_PhysicianLayout.cshtml";
}
 
<h2 class="mb-4">👨‍⚕️ Approved Appointments</h2>
 
<table class="table table-bordered table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>Patient Name</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Date & Time</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
 
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <!-- ✅ Patient Info -->
                <td>@item.Patient?.Name</td>
                <td>@item.Patient?.Phone</td>
                <td>@item.Patient?.Address</td>
 
                <!-- Appointment Info -->
                <td>@item.AppointmentDateTime</td>
                <td>@item.Reason</td>
 
                <!-- Status -->
                <td>
                    @if (item.ScheduleStatus == "Approved")
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else if (item.ScheduleStatus == "Consulted")
                    {
                        <span class="badge bg-info">Consulted</span>
                    }
                </td>
 
                <!-- Action -->
                <td>
                    @if (item.ScheduleStatus == "Approved")
                    {
                        <a asp-action="Consulted"
                               asp-route-id="@item.AppointmentId"
                               class="btn btn-success btn-sm">
                            Consulted
                        </a>
                    }
                    else if (item.ScheduleStatus == "Consulted")
                    {
                        <button class="btn btn-secondary btn-sm" disabled>
                            Consulted
                        </button>
 
                        <a asp-action="HideFromDashboard"
                               asp-route-id="@item.AppointmentId"
                               class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>