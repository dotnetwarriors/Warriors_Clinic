@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}
@{
    var email = Context.Session.GetString("UserEmail");
    var displayName = string.IsNullOrEmpty(email) ? "User" : email.Split('@')[0];
}
 

<style>
    .hover-card {
        transition: all 0.3s ease;
    }

        .hover-card:hover {
            transform: scale(1.08);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }
</style>

<div class="container-fluid">

    <h2 class="mb-4 fw-bold">
        Welcome, @displayName 👋
    </h2>

    <div class="row g-4">

        <!-- BOOK APPOINTMENT -->
        <div class="col-md-3">
            <a asp-controller="Appointment" asp-action="Create"
                   class="btn btn-light w-100 shadow-sm text-center p-4 h-100 border hover-card">

                <i class="bi bi-calendar-plus display-5 text-primary mb-3"></i>
                <h5 class="fw-semibold">Book Appointment</h5>
                <p class="text-muted small mb-0">Schedule a new visit</p>

            </a>
        </div>

        <!-- MY APPOINTMENTS -->
        <div class="col-md-3">
            <a asp-controller="Appointment" asp-action="MyAppointments"
                   class="btn btn-light w-100 shadow-sm text-center p-4 h-100 border hover-card">

                <i class="bi bi-calendar-check display-5 text-success mb-3"></i>
                <h5 class="fw-semibold">My Appointments</h5>
                <p class="text-muted small mb-0">View your bookings</p>

            </a>
        </div>

        <!-- VIEW SCHEDULE -->
        <div class="col-md-3">
            <a asp-controller="Appointment" asp-action="ViewSchedule"
                   class="btn btn-light w-100 shadow-sm text-center p-4 h-100 border hover-card">

                <i class="bi bi-clock display-5 text-warning mb-3"></i>
                <h5 class="fw-semibold">View Schedule</h5>
                <p class="text-muted small mb-0">Check doctor availability</p>

            </a>
        </div>

        <!-- PRESCRIPTIONS -->
        <div class="col-md-3">
            <a asp-controller="Patient" asp-action="ViewPrescription"
                   class="btn btn-light w-100 shadow-sm text-center p-4 h-100 border hover-card">

                <i class="bi bi-file-medical display-5 text-info mb-3"></i>
                <h5 class="fw-semibold">Prescriptions</h5>
                <p class="text-muted small mb-0">View your medicines</p>

            </a>
        </div>

        <!-- CHAT -->
        <div class="col-md-3">
            <a asp-controller="Chat" asp-action="Index" asp-route-receiverId="@ViewBag.DoctorId"
                   class="btn btn-light w-100 shadow-sm text-center p-4 h-100 border hover-card">

                <i class="bi bi-chat-dots display-5 text-danger mb-3"></i>
                <h5 class="fw-semibold">Chat Box</h5>
                <p class="text-muted small mb-0">Talk with doctor</p>

            </a>
        </div>

    </div>

</div>