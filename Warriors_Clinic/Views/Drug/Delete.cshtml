@model Warriors_Clinic.Models.Drug

@{
    var role = Context.Session.GetString("UserRole");

    if (role == "Chemist")
    {
        Layout = "~/Views/Shared/_ChemistLayout.cshtml";
    }
    else if (role == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (role == "Physician")
    {
        Layout = "~/Views/Shared/_PhysicianLayout.cshtml";
    }
    else if (role == "Patient")
    {
        Layout = "~/Views/Shared/_PatientLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml"; // Guest
    }
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Drug</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tittle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tittle)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Expiry)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Expiry)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Dosage)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Dosage)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="DrugId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
