@model IEnumerable<Warriors_Clinic.Models.Drug>

@{
    Layout = "~/Views/Shared/_ChemistLayout.cshtml";
}

<div class="card shadow-lg">

    <div class="card-header bg-primary text-white d-flex justify-content-between">
        <h4 class="mb-0">💊 Drug Management</h4>
        <a href="/Drug/Create" class="btn btn-light">+ Add Drug</a>
    </div>

    <div class="card-body">

        <table class="table table-hover align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Expiry</th>
                    <th>Dosage</th>
                    <th style="width:200px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Tittle</td>
                        <td>@item.Description</td>
                        <td>@item.Expiry</td>
                        <td>@item.Dosage</td>

                        <td>
                            <a href="/Drug/Edit/@item.DrugId" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/Drug/Details/@item.DrugId" class="btn btn-sm btn-info">View</a>
                            <a href="/Drug/Delete/@item.DrugId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>