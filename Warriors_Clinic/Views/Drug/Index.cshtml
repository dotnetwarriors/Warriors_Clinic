@model IEnumerable<Warriors_Clinic.Models.Drug>

@{
    var role = Context.Session.GetString("UserRole");

    if (role == "Chemist")
    {
        Layout = "~/Views/Shared/_ChemistLayout.cshtml";
    }
    else if (role == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (role == "Physician")
    {
        Layout = "~/Views/Shared/_PhysicianLayout.cshtml";
    }
    else if (role == "Patient")
    {
        Layout = "~/Views/Shared/_PatientLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<div class="card shadow-lg">

    <!-- 🔷 HEADER -->
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0">💊 Drug Management</h4>
            <small>Search medicines instantly</small>
        </div>

        @if (role == "Chemist")
        {
            <a href="/Drug/Create" class="btn btn-light">+ Add Drug</a>
        }
    </div>

    <div class="card-body">

        <!-- 🔍 SEARCH BAR -->
        <div class="mb-3 d-flex justify-content-between">

            <form method="get" asp-action="Index" class="d-flex w-50">
                <input type="text" name="search"
                       value="@Context.Request.Query["search"]"
                       class="form-control me-2"
                       placeholder="🔍 Search by name or description..." />

                <button type="submit" class="btn btn-primary">Search</button>
            </form>

            @if (!string.IsNullOrEmpty(Context.Request.Query["search"]))
            {
                <a href="/Drug/Index" class="btn btn-secondary">Clear</a>
            }

        </div>

        <!-- 🔷 TABLE -->
        <table class="table table-hover align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Expiry</th>
                    <th>Dosage</th>
                    <th style="width:200px;">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-muted text-center">
                            No drugs found 😔
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Tittle</strong></td>
                            <td>@item.Description</td>
                            <td>@item.Expiry</td>
                            <td>@item.Dosage</td>

                            <td>
                                <a asp-action="Details" asp-route-id="@item.DrugId"
                                   class="btn btn-sm btn-info">View</a>

                                @if (role == "Chemist")
                                {
                                    <a asp-action="Edit" asp-route-id="@item.DrugId"
                                       class="btn btn-sm btn-warning">Edit</a>

                                    <a asp-action="Delete" asp-route-id="@item.DrugId"
                                       class="btn btn-sm btn-danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>

    </div>
</div>