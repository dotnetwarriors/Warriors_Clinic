@model Warriors_Clinic.Models.Drug

@{
    var role = Context.Session.GetString("UserRole");

    if (role == "Chemist")
    {
        Layout = "~/Views/Shared/_ChemistLayout.cshtml";
    }
    else if (role == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (role == "Physician")
    {
        Layout = "~/Views/Shared/_PhysicianLayout.cshtml";
    }
    else if (role == "Patient")
    {
        Layout = "~/Views/Shared/_PatientLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml"; // Guest
    }
}

<div class="container mt-4">

    <div class="card shadow-lg p-4">

        <h3 class="mb-4 text-primary">💊 Drug Details</h3>

        <dl class="row">

            <dt class="col-sm-3 fw-semibold">Title</dt>
            <dd class="col-sm-9">@Model.Tittle</dd>

            <dt class="col-sm-3 fw-semibold">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3 fw-semibold">Expiry</dt>
            <dd class="col-sm-9">@Model.Expiry</dd>

            <dt class="col-sm-3 fw-semibold">Dosage</dt>
            <dd class="col-sm-9">@Model.Dosage</dd>

        </dl>

        <div class="mt-4 d-flex gap-2">

            <!-- Only Chemist -->
            @if (role == "Chemist")
            {
                <a asp-action="Edit" asp-route-id="@Model.DrugId" class="btn btn-warning">
                    ✏️ Edit
                </a>
            }

            <!-- Everyone -->
            <a asp-action="Index" class="btn btn-secondary">
                ⬅ Back
            </a>

        </div>

    </div>

</div>