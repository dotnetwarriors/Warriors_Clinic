@model Warriors_Clinic.Models.Physician
 
@{
    ViewData["Title"] = "Add Physician";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="w-100 d-flex justify-content-start mb-3">
    
    <button onclick="document.referrer ? history.back() : location.href='/Admin/Dashboard'"
            class="btn btn-light shadow rounded-circle p-2">
        🡨
    </button>

</div>
 
<h2 class="mb-4">➕ Add New Physician</h2>
 
<form asp-action="AddPhysician" asp-controller"Admin" method="post">
 
    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
 
    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" required />
    </div>
 
    <div class="mb-3">
        <label>Phone</label>
        <input asp-for="Phone" class="form-control" required />
    </div>
 
    <div class="mb-3">
        <label>Address</label>
        <input asp-for="Address" class="form-control" />
    </div>
 
    <div class="mb-3">
        <label>Specialization</label>
        <input asp-for="Specialization" class="form-control" />
    </div>
 
    <div class="mb-3">
        <label>Summary</label>
        <textarea asp-for="Summary" class="form-control"></textarea>
    </div>
 
    <button type="submit" class="btn btn-success w-100">
        Save Physician
    </button>
 
</form>