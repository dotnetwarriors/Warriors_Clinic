@model Warriors_Clinic.Models.Chemist
 
@{
    ViewData["Title"] = "Edit Chemist";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
 
<h2 class="mb-4">✏️ Edit Chemist</h2>
 
<form asp-action="EditChemist" method="post">
 
    <input type="hidden" asp-for="ChemistId" />
 
    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
 
    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" required />
    </div>
 
    <div class="mb-3">
        <label>Phone</label>
        <input asp-for="Phone" class="form-control" required />
    </div>
 
    <div class="mb-3">
        <label>Address</label>
        <input asp-for="Address" class="form-control" />
    </div>
 
    <div class="mb-3">
        <label>Summary</label>
        <textarea asp-for="Summary" class="form-control"></textarea>
    </div>
 
    <button type="submit" class="btn btn-warning w-100">
        Update Chemist
    </button>
 
</form>