@model IEnumerable<Warriors_Clinic.Models.ViewModels.ChemistVM>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .table tbody tr:hover {
        background-color: #f5f5f5;
        transition: 0.2s;
    }
</style>
<div class="w-100 d-flex justify-content-start mb-3">
    
    <button onclick="document.referrer ? history.back() : location.href='/Admin/Dashboard'"
            class="btn btn-light shadow rounded-circle p-2">
        🡨
    </button>

</div>

<h2 class="mb-4">Chemists</h2>

<table class="table table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>

                <td>
                    @if (item.Status == "Active")
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Disabled</span>
                    }
                </td>

                <td class="text-center">

                    @if (item.Status == "Active")
                    {
                        <a asp-action="DisableChemist"
                               asp-route-id="@item.ChemistId"
                               class="btn btn-danger btn-sm me-1">
                            Disable
                        </a>
                    }
                    else
                    {
                        <a asp-action="EnableChemist"
                               asp-route-id="@item.ChemistId"
                               class="btn btn-danger btn-sm me-1">
                            Enable
                        </a>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>