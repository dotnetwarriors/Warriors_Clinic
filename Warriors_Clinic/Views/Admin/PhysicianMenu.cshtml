@{
    ViewData["Title"] = "Physician Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="w-100 d-flex justify-content-start mb-3">
    
        <button onclick="document.referrer ? history.back() : location.href='/Admin/Dashboard'"
                class="btn btn-light shadow rounded-circle p-2">
            🡨
        </button>

    </div>


    <div class="text-center mb-5">
        <h1 class="fw-bold">👨‍⚕️ Physician Management</h1>
    </div>

    <div class="row justify-content-center g-5">

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 text-center p-5 rounded-5 card-hover">

                <h4 class="mb-4">➕ New Physician</h4>

                <a asp-action="AddPhysician"
                       class="btn btn-outline-primary w-75 mx-auto py-3 fs-5 rounded-3">
                    Add
                </a>

            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 text-center p-5 rounded-5 card-hover">

                <h4 class="mb-4">📋 Physician List</h4>

                <a asp-action="PhysicianList"
                       class="btn btn-outline-dark w-75 mx-auto py-3 fs-5 rounded-3">
                    View
                </a>

            </div>
        </div>

    </div>

</div>