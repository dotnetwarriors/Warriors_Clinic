@model IEnumerable<Warriors_Clinic.Models.User>
 
@{
    ViewData["Title"] = "Pending Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center mb-4">Pending User Approvals</h2>

<table class="table table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td class="text-center">
                    <a href="/Admin/Approve/@user.UserId" class="btn btn-success btn-sm">
                        Approve
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>