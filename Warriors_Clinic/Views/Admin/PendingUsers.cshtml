@model IEnumerable<Warriors_Clinic.Models.User>
 
@{
    ViewData["Title"] = "Pending Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="w-100 d-flex justify-content-start mb-3">
    
    <button onclick="document.referrer ? history.back() : location.href='/Admin/Dashboard'"
            class="btn btn-light shadow rounded-circle p-2">
        🡨
    </button>

</div>
<h2 class="text-center mb-4">Pending User Approvals</h2>

<table class="table table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Status</th>
            <th>Approved</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    @if (user.Status == "Active")
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Disabled</span>
                    }
                </td>

                <td>
                    @if (user.IsApproved)
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                </td>

                <td class="text-center">

                    @if (!user.IsApproved)
                    {
                        <a asp-action="Approve"
                               asp-route-id="@user.UserId"
                               class="btn btn-success btn-sm">
                            Approve
                        </a>
                    }

                    @if (user.Status == "Active")
                    {
                        <a asp-action="DisableUser"
                               asp-route-id="@user.UserId"
                               class="btn btn-danger btn-sm">
                            Disable
                        </a>
                    }
                    else
                    {
                        <a asp-action="EnableUser"
                               asp-route-id="@user.UserId"
                               class="btn btn-primary btn-sm">
                            Enable
                        </a>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>