@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">💊 Chemist Management</h1>
    </div>

    <div class="row justify-content-center g-5">

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 text-center p-5 rounded-5 card-hover">

                <h4 class="mb-4">➕ New Chemist</h4>

                <a asp-action="AddChemist"
                       class="btn btn-outline-primary w-75 mx-auto py-3 fs-5 rounded-3">
                    Add
                </a>

            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 text-center p-5 rounded-5 card-hover">

                <h4 class="mb-4">📋 Chemist List</h4>

                <a asp-action="ChemistList"
                       class="btn btn-outline-dark w-75 mx-auto py-3 fs-5 rounded-3">
                    View
                </a>

            </div>
        </div>

    </div>

</div>