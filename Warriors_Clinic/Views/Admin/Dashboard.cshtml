@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .card:hover {
        transform: translateY(-5px);
        transition: 0.3s;
    }
</style>

<div class="container-fluid">

    <h2 class="mb-4 fw-bold text-center">
        Welcome Admin 👨‍💼
    </h2>

    <div class="row g-4 justify-content-center">

        <!-- Pending Users -->
        <div class="col-md-4">
            <a asp-action="PendingUsers" class="text-decoration-none">
                <div class="card shadow-sm text-center p-4 border-0">
                    <i class="bi bi-people display-4 text-warning mb-3"></i>
                    <h5 class="fw-semibold">Pending Users</h5>
                    <p class="text-muted small">Approve or reject new users</p>
                </div>
            </a>
        </div>

        <!-- Appointments -->
        <div class="col-md-4">
            <a asp-action="AppointmentRequests" class="text-decoration-none">
                <div class="card shadow-sm text-center p-4 border-0">
                    <i class="bi bi-calendar-check display-4 text-success mb-3"></i>
                    <h5 class="fw-semibold">Appointments</h5>
                    <p class="text-muted small">View all clinic appointments</p>
                </div>
            </a>
        </div>

        <!-- Workforce -->
        <div class="col-md-4">
            <a asp-action="Workforce" class="text-decoration-none">
                <div class="card shadow-sm text-center p-4 border-0">
                    <i class="bi bi-people display-4 text-warning mb-3"></i>
                    <h5 class="fw-semibold">Workforce</h5>
                    <p class="text-muted small">Manage doctors & staff</p>
                </div>
            </a>
        </div>

    </div>

</div>