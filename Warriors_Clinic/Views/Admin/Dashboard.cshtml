@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
 
<h2 class="text-center mt-4">Welcome Admin 👨‍💼</h2>
 
<div class="container mt-4">
 
    <div class="row g-3">
 
        <!-- 🔵 USER REQUESTS -->
        <div class="col-md-4">
            <a asp-controller="Admin" asp-action="PendingUsers" class="btn btn-primary w-100 p-3">
                👤 New User Requests
            </a>
        </div>
 
        <!-- 🟢 APPOINTMENTS -->
        <div class="col-md-4">
            <a asp-controller="Admin" asp-action="AppointmentRequests" class="btn btn-success w-100 p-3">
                📅 Appointment Requests
            </a>
        </div>
 
        <!-- 🟡 WORKFORCE -->
        <div class="col-md-4">
            <a asp-controller="Admin" asp-action="Workforce" class="btn btn-warning w-100 p-3">
                🏥 Workforce Management
            </a>
        </div>
 
    </div>
 
</div>
 