@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">

    <!-- ✅ CENTERED TITLE -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">Welcome Admin 👨‍💼</h2>
    </div>

    <!-- ✅ CENTERED CARDS -->
    <div class="row justify-content-center g-5 mt-4">

        <!-- CARD 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 p-5 text-center h-100 rounded-4">

                <h5 class="text-muted mb-3 fs-5">Pending Users</h5>

                <h1 class="fw-bold text-primary mb-4 display-5">
                    @ViewBag.PendingUsers
                </h1>

                <a asp-controller="Admin"
                       asp-action="PendingUsers"
                       class="btn btn-outline-primary w-100 py-3 fs-5">
                    Manage
                </a>

            </div>
        </div>

        <!-- CARD 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 p-5 text-center h-100 rounded-4">

                <h5 class="text-muted mb-3 fs-5">Appointments</h5>

                <h1 class="fw-bold text-success mb-4 display-5">
                    @ViewBag.Appointments
                </h1>

                <a asp-controller="Admin"
                       asp-action="AppointmentRequests"
                       class="btn btn-outline-success w-100 py-3 fs-5">
                    View
                </a>

            </div>
        </div>

        <!-- CARD 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 p-5 text-center h-100 rounded-4">
               

                <h5 class="text-muted mb-3 fs-5">Workforce</h5>

                <h1 class="fw-bold text-warning mb-4 display-5">
                    @ViewBag.Workforce
                </h1>

                <a asp-controller="Admin"
                       asp-action="Workforce"
                       class="btn btn-outline-warning w-100 py-3 fs-5">
                    Manage
                </a>

            </div>
        </div>

    </div>

</div>