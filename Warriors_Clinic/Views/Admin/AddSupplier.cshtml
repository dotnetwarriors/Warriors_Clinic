@model Warriors_Clinic.Models.Supplier
 
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="w-100 d-flex justify-content-start mb-3">
    
    <button onclick="document.referrer ? history.back() : location.href='/Admin/Dashboard'"
            class="btn btn-light shadow rounded-circle p-2">
        🡨
    </button>

</div>
 
<h2>Add Supplier</h2>
 
<form method="post">
 
    <input asp-for="Name" class="form-control mb-2" placeholder="Name" />
    <input asp-for="Email" class="form-control mb-2" placeholder="Email" />
    <input asp-for="Phone" class="form-control mb-2" placeholder="Phone" />
    <input asp-for="Address" class="form-control mb-2" placeholder="Address" />
 
    <button class="btn btn-success w-100">Save Supplier</button>
 
</form>