@model List<Warriors_Clinic.Models.Supplier>
 
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
 
<h2>Suppliers</h2>
 
<a asp-action="AddSupplier" class="btn btn-primary mb-3">
    ➕ Add New Supplier
</a>
 
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Action</th>
        </tr>
    </thead>
 
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>
                    <a asp-action="EditSupplier" asp-route-id="@item.SupplierId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="DeleteSupplier" asp-route-id="@item.SupplierId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>