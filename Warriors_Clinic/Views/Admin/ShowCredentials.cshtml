@model Warriors_Clinic.Models.User

@{
    ViewData["Title"] = "ShowCredentials";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<<h1>User Created Successfully ✅</h1>
 
    <div class="card p-4 mt-4">
        <h4>Login Credentials</h4>
 
        <p><strong>Role:</strong> @ViewBag.Role</p>
        <p><strong>Username:</strong> @ViewBag.Username</p>
        <p><strong>Password:</strong> @ViewBag.Password</p>
 
        <a href="/Admin/PhysicianList" class="btn btn-primary mt-3">
            Go to List
        </a>
    </div>

