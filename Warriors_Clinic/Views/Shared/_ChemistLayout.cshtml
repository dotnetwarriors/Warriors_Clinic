<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Chemist Panel</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background-color: #f4f6f9;
            }

            .navbar-brand {
                font-weight: bold;
            }

            .main-container {
                margin-top: 40px;
            }

            .card-hover:hover {
                transform: translateY(-5px);
                transition: 0.3s;
            }
    </style>
</head>

<body>

    <!-- 🔵 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary px-4">
        <a class="navbar-brand" href="#">🏥 Warriors Clinic</a>

        <div class="ms-auto">
            <span class="text-white me-3">
                Welcome, @Context.Session.GetString("UserName")
            </span>

            <a class="btn btn-light me-2" href="/Chemist/Dashboard">Dashboard</a>
            <a class="btn btn-light me-2" href="/Chemist/DrugRequests">Drug Requests</a>
            <a class="btn btn-light me-2" href="/Drug">Manage Drugs</a>
            <a class="btn btn-danger" href="/Account/Logout">Logout</a>
        </div>
    </nav>

    <!-- 🔷 MAIN CONTENT -->
    <div class="container main-container">
        @RenderBody()
    </div>

</body>
</html>