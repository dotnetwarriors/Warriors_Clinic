<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
 
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
 
<body>
 
    <!-- 🔵 NAVBAR -->
    @{
        var currentPath = Context.Request.Path.ToString().ToLower();
    }


    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">

        <a class="navbar-brand fw-bold" asp-controller="Admin" asp-action="Dashboard">
            Admin Panel
        </a>

        <div class="collapse navbar-collapse">

            <ul class="navbar-nav me-auto">

                @if (!currentPath.Contains("/admin/dashboard"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                            Dashboard
                        </a>
                    </li>
                }

                @if (!currentPath.Contains("/admin/pendingusers"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="PendingUsers">
                            Pending Users
                        </a>
                    </li>
                }

                @if (!currentPath.Contains("/admin/appointmentrequests"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="AppointmentRequests">
                            Appointments
                        </a>
                    </li>
                }

                @if (!currentPath.Contains("/admin/workforce"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Workforce">
                            Workforce
                        </a>
                    </li>
                }

            </ul>

            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="btn btn-danger ms-3"
                           asp-controller="Account"
                           asp-action="Logout">
                        Logout
                    </a>
                </li>
            </ul>

        </div>

    </nav>
 
    <!-- 🟢 PAGE CONTENT -->
    <div class="container mt-4">
        @RenderBody()
    </div>
 
</body>
</html>