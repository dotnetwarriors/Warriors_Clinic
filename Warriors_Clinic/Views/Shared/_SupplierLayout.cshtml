<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Supplier Panel</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            .navbar-brand {
                font-size: 1.3rem;
            }
    </style>
</head>

<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var userName = Context.Session.GetString("UserName");
    }

    <!-- 🔵 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm fixed-top">
        <div class="container-fluid">

            <!-- LEFT -->
            <a class="navbar-brand fw-bold" href="#">📦 Supplier Panel</a>

            <!-- RIGHT -->
            <div class="d-flex align-items-center">

                @* SHOW WELCOME ONLY IN DASHBOARD *@
                @if (currentAction == "Dashboard")
                {
                    <span class="badge bg-light text-dark me-3 p-2">
                        👋 Welcome @userName
                    </span>
                }

                @* SHOW DASHBOARD BUTTON ONLY WHEN NOT IN DASHBOARD *@
                @if (currentAction != "Dashboard")
                {
                    <a class="btn btn-outline-light me-2" href="/Supplier/Dashboard">
                        📊 Dashboard
                    </a>
                }

                <a class="btn btn-danger ms-2" href="/Account/Logout">
                    Logout
                </a>

            </div>

        </div>
    </nav>

    <!-- 🔷 MAIN CONTENT -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_Footer")
</body>
</html>