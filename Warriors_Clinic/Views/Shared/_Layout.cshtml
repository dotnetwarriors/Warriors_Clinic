<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Tittle>@ViewData["Tittle"] - Warriors_Clinic</Tittle>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Warriors_Clinic.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
            <div class="container">
        
                <!-- LOGO LEFT -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🏥 Warriors Clinic
                </a>

                <!-- TOGGLE BUTTON -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU RIGHT -->
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                   <ul class="navbar-nav">
 
    <li class="nav-item">
        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
    </li>
 
    <li class="nav-item">
        <a class="nav-link" asp-controller="ClinicInfo" asp-action="Index">About Clinic</a>
    </li>
 
    <li class="nav-item">
        <a class="nav-link" asp-controller="Drug" asp-action="Index">Explore Drugs</a>
    </li>
 
                        @{
                            var userName = Context.Session.GetString("UserName");
                            var role = Context.Session.GetString("Role");
                        }
 
                        @if (userName != null)
                        {
                            <!-- ROLE BASED MENU -->
                            @if (role == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="PendingUsers">
                                        Manage Users
                                    </a>
                                </li>
                            }
 
                            @if (role == "Patient")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Patient" asp-action="Dashboard">
                                        Dashboard
                                    </a>
                                </li>
 
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Appointment" asp-action="Create">
                                        Book Appointment
                                    </a>
                                </li>
                            }
 
                            <!-- USER NAME -->
                            <li class="nav-item">
                                <span class="nav-link text-warning fw-bold">
                                    👤 @userName
                                </span>
                            </li>
 
                            <!-- LOGOUT -->
                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                       asp-controller="Account"
                                       asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Account"
               asp-action="Register">
                Register
            </a>
        </li>
 
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Account"
               asp-action="Login">
                Login
            </a>
        </li>
    }
 
</ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white text-center p-3 mt-5">
        <p class="mb-0">© 2026 Warriors Clinic | All Rights Reserved</p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
