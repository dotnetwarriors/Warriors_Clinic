<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warriors Clinic</title>

    <!-- ✅ Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- ✅ Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- ✅ IMPORTANT (Fixes styling + paths) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>


<body class="d-flex flex-column min-vh-100">

    <!-- 🔷 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3 fixed-top">
        <div class="container">

            <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                🏥 Warriors Clinic
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link px-3" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3" asp-controller="ClinicInfo" asp-action="Index">About</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3" asp-controller="Drug" asp-action="Index">Drug Dictionary</a>
                    </li>

                    @{
                        var userName = Context.Session.GetString("UserName");
                    }

                    @if (userName == null)
                    {
                        <li class="nav-item ms-2">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4">
                                Login
                            </a>
                        </li>

                        <li class="nav-item ms-2">
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary px-4">
                                New Patient Register
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-3">
                            <span class="fw-semibold text-dark">👤 @userName</span>
                        </li>

                        <li class="nav-item ms-3">
                            <a asp-controller="Account" asp-action="Logout" class="btn btn-danger px-3">
                                Logout
                            </a>
                        </li>
                    }

                </ul>
            </div>

        </div>
    </nav>

   
   
        @RenderBody()



    <!-- ✅ Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ✅ Optional Scripts -->
    @RenderSection("Scripts", required: false)
    
    @await Html.PartialAsync("_Footer")
</body>
</html>