<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Patient</title>
 
    <!-- ✅ Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
 
<body>
 
    <!-- 🔷 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
 
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                🏥 Warriors Clinic
            </a>
 
            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav">
 
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                   
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="ClinicInfo" asp-action="Index">About Clinic</a>
                    </li>
 
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Drug" asp-action="Index">Explore Drugs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Patient" asp-action="Profile">Profile</a>
                    </li>
                  
                    <li class="nav-item">
                        <span class="nav-link text-warning fw-bold">
                            👤 @Context.Session.GetString("UserName")
                        </span>
                    </li>
 
                    <li class="nav-item">
                        <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                    </li>
 
                </ul>
            </div>
 
        </div>
    </nav>
 
    <!-- 🔷 BODY -->
    <div class="container mt-4">
        @RenderBody()
    </div>
 
    <!-- 🔷 FOOTER -->
    <footer class="bg-dark text-white text-center p-3 mt-5">
        <p class="mb-0">© 2026 Warriors Clinic | Patient Panel</p>
    </footer>
 
    <!-- ✅ Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
 
</body>
</html>