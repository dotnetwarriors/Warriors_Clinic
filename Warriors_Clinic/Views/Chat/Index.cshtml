@model List<Warriors_Clinic.Models.Message>

@{
    var role = Context.Session.GetString("UserRole");
    var currentUserId = Context.Session.GetInt32("UserId");

    Layout = role == "Physician"
        ? "~/Views/Shared/_PhysicianLayout.cshtml"
        : "~/Views/Shared/_PatientLayout.cshtml";
}

<div class="container">

    <div class="card shadow">

        <!-- 🔷 HEADER -->
        <div class="card-header bg-primary text-white">
            💬 Chat
        </div>

        <!-- 🔷 CHAT BODY -->
        <div class="card-body" style="height:400px; overflow-y:auto; background:#f8f9fa;">

            @foreach (var msg in Model)
            {
                if (msg.SenderId == currentUserId)
                {
                    <!-- ✅ SENT MESSAGE -->
                    <div class="d-flex justify-content-end mb-2">
                        <div class="bg-primary text-white p-2 rounded"
                             style="max-width:60%;">
                            @msg.MessageText
                        </div>
                    </div>
                }
                else
                {
                    <!-- ✅ RECEIVED MESSAGE -->
                    <div class="d-flex justify-content-start mb-2">
                        <div class="bg-light border p-2 rounded"
                             style="max-width:60%;">
                            @msg.MessageText
                        </div>
                    </div>
                }
            }

        </div>

        <!-- 🔷 INPUT -->
        <div class="card-footer bg-white">

            <form asp-action="Send" method="post" class="d-flex gap-2">

                <input type="hidden" name="receiverId" value="@ViewBag.ReceiverId" />

                <input type="text"
                       name="messageText"
                       class="form-control"
                       placeholder="Type message..."
                       required />

                <button class="btn btn-primary">
                    Send
                </button>

            </form>

        </div>

    </div>

</div>