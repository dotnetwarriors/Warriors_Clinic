@{
    ViewData["Tittle"] = "Home Page";
}
<!-- HERO SECTION -->
<!-- 🔷 HERO -->
<section class="py-5">
    <div class="container">

        <div class="row align-items-center">

            <!-- LEFT -->
            <div class="col-md-6 text-center text-md-start">

                <h1 class="fw-bold display-4">
                    Smart Clinic <br /> Management System
                </h1>

                <p class="text-muted mt-3">
                    A complete solution to manage patients, doctors,
                    appointments, prescriptions and inventory efficiently.
                </p>

                <div class="mt-4">
                    <a asp-controller="Account" asp-action="Register"
                           class="btn btn-primary btn-lg px-4">
                        Get Started to Register
                    </a>
                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-md-6 text-center mt-4 mt-md-0">
                <div class="border rounded p-5 bg-white shadow-sm">
                    <img src="~/images/pic.png"
                         class="img-fluid rounded shadow-sm"
                         alt="Clinic Image" />
                </div>
            </div>

        </div>

    </div>
</section>

<!-- 🔷 FEATURES -->
<section class="py-5 bg-light">
    <div class="container text-center">

        <h2 class="fw-bold mb-3">Features</h2>
        <p class="text-muted mb-5">Everything you need to manage your clinic</p>

        <div class="row g-4">

            <!-- FEATURE 1 -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-calendar-check display-4"></i>
                    </div>
                    <h5 class="fw-semibold">Appointment System</h5>
                    <p class="text-muted">Book and manage appointments easily</p>
                </div>
            </div>

            <!-- FEATURE 2 -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-people display-4"></i>
                    </div>
                    <h5 class="fw-semibold">Doctor & Patient Management</h5>
                    <p class="text-muted">Maintain complete medical records</p>
                </div>
            </div>

            <!-- FEATURE 3 -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-capsule display-4"></i>
                    </div>
                    <h5 class="fw-semibold">Inventory & Drugs</h5>
                    <p class="text-muted">Track medicines and stock efficiently</p>
                </div>
            </div>

        </div>

    </div>
</section>

<div class="container py-5">

    <h2 class="text-primary text-center fw-bold mb-2">What Patients Say</h2>
    <p class="text-muted text-center mb-5">Real feedback from our happy patients</p>

    <div class="row g-4 justify-content-center">

        <!-- REVIEW 1 -->
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 text-center p-4">

                <div class="mb-3 text-warning">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                </div>

                <p class="text-muted">
                    "Excellent service and friendly doctors!"
                </p>

                <div class="mt-3">
                    <h6 class="fw-bold mb-0">Rahul</h6>
                    <small class="text-muted">Patient</small>
                </div>

            </div>
        </div>

        <!-- REVIEW 2 -->
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 text-center p-4">

                <div class="mb-3 text-warning">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-half"></i>
                </div>

                <p class="text-muted">
                    "Quick treatment and very professional."
                </p>

                <div class="mt-3">
                    <h6 class="fw-bold mb-0">Sneha</h6>
                    <small class="text-muted">Patient</small>
                </div>

            </div>
        </div>

        <!-- REVIEW 3 -->
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 text-center p-4">

                <div class="mb-3 text-warning">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                </div>

                <p class="text-muted">
                    "Best clinic experience I ever had."
                </p>

                <div class="mt-3">
                    <h6 class="fw-bold mb-0">Arjun</h6>
                    <small class="text-muted">Patient</small>
                </div>

            </div>
        </div>

    </div>

</div>