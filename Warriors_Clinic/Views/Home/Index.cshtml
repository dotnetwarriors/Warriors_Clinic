@{
    ViewData["Title"] = "Home Page";
}
 
<!-- 🔥 HERO SECTION -->
<section class="hero-section d-flex align-items-center">
 
    <div class="container-fluid">
        <div class="row">
 
            <!-- LEFT CONTENT -->
            <div class="col-md-6 d-flex flex-column justify-content-center text-white p-5">
                <h1>Welcome,<br/>To Warriors Clinic</h1>
 
                <p class="mt-3">
                    Delivering trusted healthcare with modern technology.
                    Manage appointments, patients, prescriptions, and medical records
                    seamlessly <br />All in one smart platform designed for efficiency and care
                </p>
 
                <div class="mt-4">
                    <a asp-controller="Account" asp-action="Register"
                           class="btn btn-primary px-4 rounded-pill">
                        Get Started
                    </a>
                </div>
 
           
        </div>
    </div>
 
</section>
 
 
<!-- 🔥 FEATURES -->
<section class="py-5 bg-light">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Features</h2>
        <p class="text-muted mb-5">Everything you need to manage your clinic</p>
 
        <div class="row g-4">
 
            <div class="col-md-4">
                <div class="card feature-card p-4 h-100">
                    <i class="bi bi-calendar-check display-4 text-primary"></i>
                    <h5 class="mt-3 fw-semibold">Appointment System</h5>
                    <p class="text-muted">Book and manage appointments easily</p>
                </div>
            </div>
 
            <div class="col-md-4">
                <div class="card feature-card p-4 h-100">
                    <i class="bi bi-people display-4 text-primary"></i>
                    <h5 class="mt-3 fw-semibold">Doctor & Patient Management</h5>
                    <p class="text-muted">Maintain complete medical records</p>
                </div>
            </div>
 
            <div class="col-md-4">
                <div class="card feature-card p-4 h-100">
                    <i class="bi bi-capsule display-4 text-primary"></i>
                    <h5 class="mt-3 fw-semibold">Inventory & Drugs</h5>
                    <p class="text-muted">Track medicines and stock efficiently</p>
                </div>
            </div>
 
        </div>
    </div>
</section>
<!-- 🔥 STATS SECTION -->
<section class="py-5 text-center bg-primary">
    <div class="container">
        <div class="row">
 
            <div class="col-md-3">
                <h2 class="fw-bold text-white">500+</h2>
                    <p class="text-white">Happy Patients</p>
            </div>
 
            <div class="col-md-3">
                    <h2 class="fw-bold text-white">50+</h2>
                    <p class="text-white">Expert Doctors</p>
            </div>
 
            <div class="col-md-3">
                    <h2 class="fw-bold text-white">10+</h2>
                    <p class="text-white">Departments</p>
            </div>
 
            <div class="col-md-3">
                    <h2 class="fw-bold text-white">24/7</h2>
                    <p class="text-white">Emergency Service</p>
            </div>
 
        </div>
    </div>
</section>
 
 
<!-- 🔥 TESTIMONIALS -->
<section class="py-5">
    <div class="container text-center">
        <h2 class="text-primary fw-bold mb-2">What Patients Say</h2>
        <p class="text-muted mb-5">Real feedback from our happy patients</p>
 
        <div class="row g-4 justify-content-center">
 
            <div class="col-md-4">
                <div class="card testimonial p-4">
                    <div class="text-warning mb-3">★★★★★</div>
                    <p class="text-muted">
                        "Excellent service and friendly doctors!"
                    </p>
                    <h6 class="fw-bold mb-0">Rahul</h6>
                    <small class="text-muted">Patient</small>
                </div>
            </div>
 
            <div class="col-md-4">
                <div class="card testimonial p-4">
                    <div class="text-warning mb-3">★★★★☆</div>
                    <p class="text-muted">
                        "Quick treatment and very professional."
                    </p>
                    <h6 class="fw-bold mb-0">Sneha</h6>
                    <small class="text-muted">Patient</small>
                </div>
            </div>
 
            <div class="col-md-4">
                <div class="card testimonial p-4">
                    <div class="text-warning mb-3">★★★★★</div>
                    <p class="text-muted">
                        "Best clinic experience I ever had."
                    </p>
                    <h6 class="fw-bold mb-0">Arjun</h6>
                    <small class="text-muted">Patient</small>
                </div>
            </div>
 
        </div>
    </div>
</section>